// Prisma schema for Maxxes - Based on existing types and PostgreSQL requirements
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// User/Fan Profile
model User {
  id              String   @id @default(cuid())
  fan_id          String   @unique // For compatibility with existing frontend
  email           String?  @unique
  handle          String?  @unique // @username displayed on profile (e.g. "alexchen")
  avatar_url      String?  // Portrait photo URL; falls back to avatar_initials when null
  rewards_redeemed Int     @default(0) // Denormalized counter for profile stat
  name            String
  avatar_initials String
  city            String
  member_since    DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Fan profile data (flatten into User for simplicity)
  xp_total        Int      @default(0)
  current_tier    Tier     @default(GENERAL)
  streak_days     Int      @default(0)
  rank            Int?
  percentile      Int?
  top_artist      String?
  top_venue       String?
  events_attended Int      @default(0)
  
  // API integration fields
  spotify_id      String?
  apple_music_id  String?
  discord_id      String?
  lastfm_username String?

  // Per-fandom access page state — which fandom's tier + rewards to surface
  // on /access by default. Null = default to the user's highest-points fandom.
  selected_fandom_id String?

  // Relationships
  event_interactions UserEvent[]
  challenge_progress UserChallenge[]
  xp_transactions    XpTransaction[]
  friend_activities  FriendActivity[] @relation("UserFriendActivities")
  recent_activities  RecentActivity[]
  invitations_sent   Invitation[]     @relation("ReferrerInvites")
  followed_artists   FollowedArtist[]
  listening_events   ListeningEvent[]
  fan_tiers          FanTier[]
  reward_redemptions RewardRedemption[]

  @@map("users")
}

// Events
model Event {
  id              String        @id @default(cuid())
  event_id        String        @unique // For frontend compatibility
  title           String
  subtitle        String?
  artist          String?
  venue           String
  city            String
  date            DateTime
  category        EventCategory
  image_url       String?
  status          String?       // "upcoming", "live", "ended"
  trending        Boolean       @default(false)
  featured        Boolean       @default(false)
  created_at      DateTime      @default(now())
  
  // Relationships
  user_events     UserEvent[]
  
  @@map("events")
}

// User-Event interactions (bookmarks, attendance, etc.)
model UserEvent {
  id          String    @id @default(cuid())
  user_id     String
  event_id    String
  bookmarked  Boolean   @default(false)
  notify_me   Boolean   @default(false)
  attended    Boolean   @default(false)
  created_at  DateTime  @default(now())
  
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event       Event     @relation(fields: [event_id], references: [event_id], onDelete: Cascade)
  
  @@unique([user_id, event_id])
  @@map("user_events")
}

// Challenges
model Challenge {
  id              String    @id @default(cuid())
  challenge_id    String    @unique // For frontend compatibility
  title           String
  description     String?
  category        String    // "Attendance", "Discovery", "Social", etc.
  xp_reward       Int
  difficulty      String    @default("Medium")
  tasks           Json      // Array of task objects
  progress_target Int       @default(100)
  active          Boolean   @default(true)
  created_at      DateTime  @default(now())
  
  user_challenges UserChallenge[]
  
  @@map("challenges")
}

// User Challenge Progress
model UserChallenge {
  id             String    @id @default(cuid())
  user_id        String
  challenge_id   String
  completed      Boolean   @default(false)
  progress       Int       @default(0) // Progress percentage (0-100)
  tasks_completed Json     @default("[]") // Array of completed task IDs
  completed_at   DateTime?
  created_at     DateTime  @default(now())
  
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge      Challenge @relation(fields: [challenge_id], references: [challenge_id], onDelete: Cascade)
  
  @@unique([user_id, challenge_id])
  @@map("user_challenges")
}

// Invitations — referral program. SENT row is created when a user invites
// a friend by email; transitions to ACCEPTED when the recipient completes
// signup via /invite/[code], at which point xp_awarded is set and a Referral
// row is appended to xp_transactions.
model Invitation {
  id               String        @id @default(cuid())
  code             String        @unique
  referrer_id      String
  invitee_email    String
  status           InviteStatus  @default(SENT)
  sent_at          DateTime      @default(now())
  accepted_at      DateTime?
  accepted_user_id String?       @unique
  xp_awarded       Int           @default(0)

  referrer         User          @relation("ReferrerInvites", fields: [referrer_id], references: [id], onDelete: Cascade)

  @@unique([referrer_id, invitee_email])
  @@map("invitations")
}

enum InviteStatus {
  SENT
  ACCEPTED
  REVOKED
}

// XP Transaction Log
model XpTransaction {
  id          String    @id @default(cuid())
  user_id     String
  amount      Int
  source      String    // "Event Attendance", "Venue Check-ins", "Challenges", etc.
  reference   String?   // Event ID, Challenge ID, etc.
  description String?
  created_at  DateTime  @default(now())
  
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@map("xp_transactions")
}

// FanTier — per-fandom tier + points balance.
// lifetime_points is sticky (climbs tiers, never decreases on redemption).
// points_balance = lifetime_points − Σ RewardRedemption.points_spent for this user+fandom.
// fandom_id matches src/lib/data/seedFandoms.ts ids (e.g. 'weeknd', 'lakers').
model FanTier {
  id              String     @id @default(cuid())
  user_id         String
  fandom_id       String
  fandom_kind     FandomKind
  lifetime_points Int        @default(0)
  points_balance  Int        @default(0)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  user            User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, fandom_id])
  @@index([user_id])
  @@map("fan_tiers")
}

// Reward catalog — tier-gated experiences a user can redeem with their
// fandom-specific points_balance. tier_required is the minimum FanTierBand
// the user must reach for this reward to be Unlocked. is_included_perk=true
// rewards appear in the "Included from lower tiers" list (no redemption flow).
model Reward {
  id                String        @id @default(cuid())
  fandom_id         String
  fandom_kind       FandomKind
  name              String
  point_cost        Int
  tier_required     FanTierBand
  image_url         String?
  icon_name         String?       // lucide icon name for icon-only rewards
  is_included_perk  Boolean       @default(false)
  sort_order        Int           @default(0)
  created_at        DateTime      @default(now())

  redemptions       RewardRedemption[]

  @@index([fandom_id, tier_required])
  @@map("rewards")
}

// RewardRedemption — append-only log of a user redeeming a Reward.
// Subtracts points_spent from FanTier.points_balance; does NOT change
// lifetime_points so tier is unaffected.
model RewardRedemption {
  id           String   @id @default(cuid())
  user_id      String
  reward_id    String
  points_spent Int
  redeemed_at  DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reward       Reward   @relation(fields: [reward_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([reward_id])
  @@map("reward_redemptions")
}

enum FandomKind {
  ARTIST
  TEAM

  @@map("fandom_kind")
}

enum FanTierBand {
  NEWCOMER
  FAN
  LOYAL
  SUPERFAN
  ELITE

  @@map("fan_tier_band")
}

// Passes (Access tier rewards)
model Pass {
  id          String     @id @default(cuid())
  pass_id     String     @unique
  user_id     String?
  title       String
  description String?
  tier        Tier
  status      PassStatus @default(AVAILABLE)
  valid_until DateTime?
  created_at  DateTime   @default(now())
  claimed_at  DateTime?

  // Apple Wallet integration
  apple_wallet_serial String?   @unique
  wallet_added_at     DateTime?
  pass_kind           PassKind  @default(PERK)
  event_id            String?

  attendance_verifications AttendanceVerification[]

  @@map("passes")
}

// FollowedArtist — user's followed artists. lastfm_name is the canonical match
// key against Last.fm scrobbles (lowercase, trimmed).
model FollowedArtist {
  id            String   @id @default(cuid())
  user_id       String
  lastfm_name   String
  display_name  String
  spotify_id    String?
  image_url     String?
  followed_at   DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lastfm_name])
  @@index([user_id])
  @@map("followed_artists")
}

// ListeningEvent — append-only log of music listens captured from external
// sources. Plays whose artist_name_canonical matches a FollowedArtist for the
// same user are flagged is_followed=true and feed daily XP attribution via
// computeDailyListeningXp() in src/lib/domain/xp-rules.ts.
model ListeningEvent {
  id                     String       @id @default(cuid())
  user_id                String
  artist_name_canonical  String
  artist_display_name    String
  track_name             String
  played_at              DateTime
  source                 ListenSource
  duration_seconds       Int?
  is_followed            Boolean      @default(false)
  xp_awarded             Int          @default(0)
  recorded_at            DateTime     @default(now())

  user                   User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, source, played_at, track_name])
  @@index([user_id, played_at])
  @@index([artist_name_canonical])
  @@map("listening_events")
}

enum ListenSource {
  LASTFM
  SPOTIFY

  @@map("listen_source")
}

// AttendanceVerification — append-only log of how a user's attendance at an event was verified
model AttendanceVerification {
  id           String             @id @default(cuid())
  user_id      String
  event_id     String
  pass_id      String?
  method       VerificationMethod
  confidence   Int                // 0–100; WALLET_SCAN=90, SELF_CHECKIN=30, MANUAL=70
  xp_awarded   Int                @default(0)
  scanner_ip   String?
  metadata     Json?
  verified_at  DateTime           @default(now())

  pass         Pass?              @relation(fields: [pass_id], references: [id], onDelete: SetNull)

  @@unique([user_id, event_id, method])
  @@index([event_id])
  @@map("attendance_verifications")
}

// Friend Activity (social feed)
model FriendActivity {
  id          String   @id @default(cuid())
  user_id     String
  friend_name String
  activity    String
  xp_change   Int?
  created_at  DateTime @default(now())
  
  user        User     @relation("UserFriendActivities", fields: [user_id], references: [id], onDelete: Cascade)
  
  @@map("friend_activities")
}

// Recent Activity (user's own activity log)
model RecentActivity {
  id          String   @id @default(cuid())
  user_id     String
  activity    String
  description String?
  xp_earned   Int      @default(0)
  created_at  DateTime @default(now())
  
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@map("recent_activities")
}

// Leaderboard (computed/cached view)
model LeaderboardEntry {
  id         String   @id @default(cuid())
  user_id    String
  name       String
  xp_total   Int
  tier       Tier
  rank       Int
  city       String?
  period     Period   @default(ALL_TIME) // WEEKLY, MONTHLY, ALL_TIME
  computed_at DateTime @default(now())
  
  @@unique([user_id, period])
  @@index([period, rank])
  @@map("leaderboard")
}

// Enums
enum Tier {
  GENERAL
  LOYAL
  SUPERFAN
  ELITE

  @@map("tier")
}

enum EventCategory {
  MUSIC
  SPORTS
  THEATER
  COMEDY
  OTHER
  
  @@map("event_category")
}

enum PassStatus {
  AVAILABLE
  CLAIMED
  ACTIVE
  EXPIRED
  
  @@map("pass_status")
}

enum Period {
  WEEKLY
  MONTHLY
  ALL_TIME

  @@map("period")
}

enum PassKind {
  TICKET
  PERK
  PRESALE

  @@map("pass_kind")
}

enum VerificationMethod {
  WALLET_SCAN
  SELF_CHECKIN
  MANUAL
  TICKETMASTER_WEBHOOK

  @@map("verification_method")
}