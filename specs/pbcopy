        sports: "VENUE ACCESS — orange"

    access_and_rewards:
      route: "/rank-rewards"
      nav_label: "Rewards"
      page_title: "Access & Rewards"
      description: "Unified rank + rewards screen merging the former Score and Access screens. Organized into two sections via an internal tab toggle: My Rank and My Rewards. Completing a challenge in My Rank immediately surfaces the unlocked reward in My Rewards — cause and effect on the same screen."
      internal_tabs:
        my_rank:
          primary_components:
            - "Superfan score summary card (score, Elite badge, weekly delta, rank in city, percentile)"
            - "Community leaderboard (filterable by city/this week/all time, current user row highlighted orange, friend filter toggle)"
            - "Friends activity horizontal scroll (who passed you, who completed a challenge, who is N pts behind)"
            - "Challenges unlocking rewards (each card shows reward image, reward name, task checklist, progress bar, Limited badge)"
          required_interactions:
            - "City filter updates displayed rankings"
            - "Time period filter changes data slice"
            - "Current user row highlighted in orange"
            - "Friend filter toggle filters leaderboard to friends only"
            - "Challenge task completion checkboxes"
            - "100% complete challenge visually links to corresponding reward in My Rewards"
        my_rewards:
          primary_components:
            - "Elite/Diamond access summary bar (active count, expiring soon, top tier perks label)"
            - "Featured access cards (TOP PICK and LIMITED variants with countdown, CTA buttons)"
            - "Your passes list (Early entry / Artist presale / VIP package with status badges)"
            - "Perks by tier carousel (Fan / Loyal / Superfan / Elite with descriptions)"
            - "Unlock next progress item"
          required_interactions:
            - "Pass status display matches UI badge text exactly"
            - "Tier perks show current and locked tiers"
            - "Completed challenge rewards visually activate (badge locked → claim, CTA orange and tappable)"
            - "Claim access and View pass toggle buttons"
      color_system:
        active_earned: "#FF5C00 (orange)"
        elite_tier: "#3B28CC (purple)"
        completed_unlocked: "#1A9E56 (green)"
        locked_pending: "#8E8E93 (gray)"
      after_data_layer: "25+ ranked fans. Alex Chen at rank 18, score 8,750, highlighted orange. 5 real passes with statuses. Challenges with real task progress. Tier perks grid from tiers.json. Challenge-to-reward linkage visible."

    profile:
      route: "/profile"
      primary_components:
        - "Achievement badges with earned/unearned states"
        - "Tier progression visualization"
        - "Settings toggles for notifications and preferences"
        - "Statistics overview with streak and totals"
        - "XP breakdown by signal type"
      required_interactions:
        - "Settings toggles persist state changes"
        - "Achievement badges show tooltip descriptions"
        - "Tier progression shows next milestone"
      after_data_layer: "Alex Chen's real XP breakdown — 3,600 attendance XP, 2,840 streaming XP, 960 watch XP, 440 spend XP, 910 challenge XP. Events attended count. Top artist and venue."

  navigation:
    bottom_nav:
      height: "70px content + env(safe-area-inset-bottom)"
      style: "Persistent across all screens, light background (#FFFFFF) with 1px #E5E5EA top border"
      tabs:
        - { icon: "home", label: "Home", route: "/" }
        - { icon: "search", label: "Events", route: "/events" }
        - { icon: "trophy", label: "Rewards", route: "/rank-rewards" }
        - { icon: "user", label: "Profile", route: "/profile" }
      animations:
        screen_transitions: "300ms ease slide or fade"
        active_indicator: "150ms fade/color transition"

  animation_requirements:
    timing_specifications:
      screen_transitions: "300ms ease (not instant jumps)"
      toggle_switch: "200ms ease slide of orange pill"
      progress_bars: "600ms ease-out from 0 to actual percentage"
      score_counter: "800ms count-up from 0 to actual value"
      challenge_progress: "animates to fill percentage on screen load"
      status_badges: "no animation - renders immediately"
      bottom_nav_transitions: "150ms fade/color transition on tab change"

  demo_user:
    fan_id: "fan_001"
    name: "Alex Chen"
    city: "Los Angeles"
    xp_total: 8750
    current_tier: "Elite"
    streak_days: 12
    rank: 18
    percentile: "Top 3%"
    top_artist: "The Weeknd"
    top_venue: "SoFi Stadium"
    events_attended: 9
    xp_breakdown:
      attendance_xp: 3600
      streaming_xp: 2840
      watch_xp: 960
      spend_xp: 440
      challenge_xp: 910

  xp_scoring_model:
    description: "Signal-based XP calculation from listener activity data"
    signals:
      - { field: "minutesListened", rule: "+3 XP per hour", calculation: "(minutesListened / 60) × 3", example: "173 min → 8.6 XP" }
      - { field: "eventAttended", rule: "+200 XP per verified attendance", calculation: "if true → +200 XP", example: "true → +200 XP" }
      - { field: "concertCheckIns", rule: "In-venue engagement signal", calculation: "concertCheckIns × 50", example: "1 check-in → +50 XP" }
      - { field: "playlistSaves", rule: "Music engagement depth", calculation: "playlistSaves × 5", example: "12 saves → +60 XP" }
      - { field: "setlistSongsPlayed", rule: "Setlist engagement", calculation: "setlistSongsPlayed × 3", example: "9 songs → +27 XP" }
      - { field: "streakDays", rule: "Streak multiplier 1.0x–2.0x", calculation: "0–7 days: 1.0x | 8–14: 1.3x | 15–28: 1.5x | 28+: 2.0x", example: "12 days → 1.3x" }
      - { field: "engagementScore", rule: "Composite signal for leaderboard sort", calculation: "Use directly as score proxy 0–100", example: "91 → rank signal" }
      - { field: "xpEarnedToday", rule: "Today's XP adds to cumulative total", calculation: "xp_total + xpEarnedToday", example: "420 today → adds to 8,750 total" }

  tier_thresholds:
    description: "Single source of truth — matches Prisma enum and calculateTier() in database.ts"
    tiers:
      - { name: "General", min_xp: 0, color: "#8E8E93" }
      - { name: "Loyal", min_xp: 1000, color: "#2667FF" }
      - { name: "Superfan", min_xp: 2500, color: "#FFD700" }
      - { name: "Elite", min_xp: 5000, color: "#FF5C00" }

  state_management:
    global_state:
      fan_profile:
        fan_id: "string"
        name: "string"
        city: "string"
        xp_total: "number"
        current_tier: "General | Loyal | Superfan | Elite"
        streak_days: "number"
        rank: "number"
        percentile: "string"
        top_artist: "string"
        top_venue: "string"
        events_attended: "number"
        xp_breakdown: "object with attendance_xp, streaming_xp, watch_xp, spend_xp, challenge_xp"

    persistent_state:
      music_sports_toggle: "persists during session, resets on reload"
      filter_states: "active chips, selected dates, search queries"
      challenge_completion: "checked tasks, progress percentages"
      notification_preferences: "notify me buttons, bookmark icons"
      leaderboard_filters: "city selection, time period selection"

    session_state:
      loading_states: "for all data fetching operations"
      error_states: "graceful error handling and retry logic"
      form_validation: "real-time validation with user feedback"

  data_architecture:
    storage_method: "Server-side data fetching via SvelteKit +page.server.ts load functions. Events from Ticketmaster API, music intelligence from Spotify/Last.fm, user data from Vercel PostgreSQL. Static JSON files retained as fallback only."
    data_files:
      fan_profile:
        path: "/static/data/fan-profile.json"
        owner: "Ethan"
        description: "Alex Chen demo user profile with full XP breakdown"
        fields_ready: ["fanId", "name", "artist", "streamsToday", "minutesListened", "eventAttended", "currentTier", "xpEarnedToday", "engagementScore", "playlistSaves", "streakDays"]
        fields_to_add: ["xp_total (8,750)", "rank (18)", "percentile (Top 3%)", "city (Los Angeles)", "top_venue", "xp_breakdown by signal type"]
        source: "Ethan's ZIP — Alex Chen record"

      events:
        path: "/static/data/events.json"
        owner: "Luke + Ethan"
        description: "20 real LA music events from Ticketmaster + 4 mock sports events"
        fields_ready: ["event_id", "event_name", "performers", "event_date", "event_time", "venue", "city", "genre", "ticket_status", "has_presale", "has_addon_products", "product_types", "spotify_artist_url"]
        fields_to_add: ["category (music/sports)", "featured flag", "image_color", "short_description"]
        source: "Luke's Ticketmaster data (20 events) + 4 mock sports events"
        minimum_records: 24
        sample_record: |
          {
            "event_id": "G5eYZ_7pjCvKP",
            "event_name": "Don Toliver: Octane Tour",
            "performers": ["Don Toliver", "SahBabii", "SoFaygo", "Chase B"],
            "event_date": "2026-06-28",
            "event_time": "19:30",
            "venue": "Crypto.com Arena",
            "city": "Los Angeles",
            "genre": "Hip-Hop/Rap",
            "category": "music",
            "ticket_status": "onsale",
            "has_presale": true,
            "featured": true,
            "spotify_artist_url": "https://open.spotify.com/artist/4Gso3d4CscCijv0lmajZWs",
            "has_addon_products": false,
            "image_color": "#1A0A30",
            "short_description": "Exclusive presale access"
          }

      leaderboard:
        path: "/static/data/leaderboard.json"
        owner: "Ethan"
        description: "25+ ranked fans for city-based leaderboard"
        fields: ["name", "city", "currentTier", "score", "rank", "weekly_delta", "is_me", "time_period"]
        source: "Ethan's ZIP (5 fans as foundation) + 20 synthetic records"
        minimum_records: 25
        notes:
          - "Alex Chen at rank 18 with score 8,750 and is_me: true"
          - "Use engagementScore × 100 as score proxy"
          - "Realistic names, cities (LA, Chicago, New York, Toronto), scores 65–98"

      challenges:
        path: "/static/data/challenges.json"
        owner: "Ethan"
        description: "5 challenges using real Maxxes behaviors"
        fields: ["id", "title", "subtitle", "reward_name", "tasks (array with is_complete flag)", "progress_fraction", "is_limited"]
        source: "Built from scratch — no existing dataset"
        minimum_records: 5
        challenge_behaviors:
          - "Attend 1 event"
          - "Stream 5 hours"
          - "Keep 7-day streak"
          - "Finish top 10"
          - "Share recap"
        completion_states: "Mix of 2/3 complete, 1/3 complete, new, and fully complete"

      passes:
        path: "/static/data/passes.json"
        owner: "Ethan"
        description: "5 passes derived from Ticketmaster add-on products"
        fields: ["name", "source_event", "pass_type", "status", "xp_tier_required"]
        source: "Luke's Ticketmaster add-on products (12 of 20 events have them)"
        minimum_records: 5
        status_distribution: "2 active, 1 starts_soon, 1 waiting_list, 1 limited"
        pass_inventory:
          - { name: "SoFi VIP Lounge Access", source: "Rocky Horror Show (Lounge add-on)", type: "Club Access", status: "active", tier: "Gold" }
          - { name: "Ariana Grande Presale", source: "Ariana Grande — Eternal Sunshine Tour", type: "Artist Presale", status: "starts_soon", tier: "Silver" }
          - { name: "Crypto.com Arena Early Entry", source: "Don Toliver — Octane Tour", type: "Venue Access", status: "active", tier: "Bronze" }
          - { name: "BMO Stadium Parking", source: "Iron Maiden World Tour (Parking add-on)", type: "Parking", status: "active", tier: "Bronze" }
          - { name: "VIP Package — Iron Maiden", source: "Iron Maiden (VIP Package Presale)", type: "VIP Package", status: "waiting_list", tier: "Platinum" }
        notes:
          - "Status labels MUST exactly match what the UI components display"

      friends:
        path: "/static/data/friends.json"
        owner: "Ethan"
        description: "8–10 friend records for social features"
