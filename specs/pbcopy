app_spec:
  name: "Maxxes MVP - Fan Ranking & Community Platform"
  version: "0.5.0-MVP"
  status: "Light theme, new tier system (General/Loyal/Superfan/Elite), direct Postgres via pg adapter, server-side data loading"

  product_direction:
    description: "Maxxes is a fan ranking, rewards, and community platform for the live events industry. It connects ticketing history and music streaming behavior into a single verified fan profile — the Superfan Score — and uses that score to unlock tier-based rewards, presale access, and community standing."
    mvp_focus: "Four-screen interactive prototype with live data from Ticketmaster, Spotify, Last.fm, and Vercel PostgreSQL, deployed to Vercel"
    business_positioning: "Platform connecting fans with live events through verified engagement scoring"
    core_directive: "Wire real data sources end-to-end. Ticketmaster Discovery API is the primary event source. Spotify is the primary music intelligence source with Last.fm as fallback. User data lives in Vercel PostgreSQL via Prisma. Auth is deferred — this is a demo prototype using a hardcoded demo user (Alex Chen)."
    questions_answered:
      - "What is my Superfan Score and how do I improve it?"
      - "What tier am I and what rewards can I unlock?"
      - "How do I rank against other fans in my city?"
      - "What challenges can I complete to earn more XP?"
      - "Which events should I attend for maximum fan engagement?"

  mvp_boundary:
    version_target: "0.2.0 → 0.3.0 by end of Week 8 lab"
    must_build:
      - "Home screen with Momentum Score card, sparkline, upcoming events, ranking summary, community activity, and trending section"
      - "Events screen with filtering, search, and booking capabilities"
      - "Access & Rewards screen — unified rank + rewards screen with internal My Rank / My Rewards toggle, merging former Score and Access screens. Navbar label: Access. Route: /access"
      - "Profile screen with XP breakdown, achievements, and settings"
      - "Persistent bottom navigation connecting all four screens"
      - "Runtime JSON data layer — 7 JSON files replacing hardcoded mock data"
      - "Client-side XP scoring calculation with signal-based transparency"
      - "All animations and state transitions as specified"
      - "Mobile-responsive design with touch-friendly interactions"
      - "Deployed to Vercel with a public URL"

    what_mvp_is_not:
      - "A static slide deck or PDF mockup"
      - "A prototype requiring live presenter explanation"
      - "An app that only works locally"
      - "A production platform with user authentication (auth is deferred to roadmap)"
      - "An Apple Music integration (excluded by product decision)"

  technology_stack:
    frontend_framework: "SvelteKit 2.0+ with TypeScript"
    styling: "Tailwind CSS 3.3+ with custom design tokens"
    build_tool: "Vite 6.0+"
    package_manager: "npm"
    deployment: "Vercel with adapter-vercel (server routes required for API proxying and database access)"
    icons: "@lucide/svelte"
    utilities:
      - "date-fns for date handling"
      - "zod for validation"
    testing:
      - "vitest for unit tests"
      - "@playwright/test for E2E testing"

  visual_design:
    theme: "Light theme (app-wide)"
    color_palette:
      primary_orange: "#FF5C00"
      bg_primary: "#F8F8FA"
      bg_card: "#FFFFFF"
      bg_card_elevated: "#F5F5F7"
      bg_input: "#F2F2F7"
      text_primary: "#000000"
      text_secondary: "#8E8E93"
      text_tertiary: "#C7C7CC"
      border_gray: "#E5E5EA"
      border_subtle: "#F0F0F0"
      success_green: "#34D399"
      error_red: "#EF4444"
      gold: "#FFD700"
      deep_navy: "#2667FF"
      deeper_indigo: "#3B28CC"

    typography:
      system: "System font stack with fallbacks (-apple-system, BlinkMacSystemFont, SF Pro Display)"
      hierarchy: "Consistent heading and body text sizing"

    layout_rules:
      page_padding: "16px horizontal (never touch screen edges)"
      card_border_radius: "14-20px (18-20px for hero cards)"
      card_borders: "1px solid #E5E5EA (inactive), 1.5-2px solid #FF5C00 (active)"
      card_gaps: "8-10px vertical, 16-20px between sections"
      bottom_nav_height: "70px content + safe area inset"
      touch_targets: "minimum 44×44px for all tappable elements"

  data_sources:
    integration_strategy: "All real data. Ticketmaster for events, Spotify + Last.fm for music intelligence, PostgreSQL for user/fan data. No mock data in production."

    source_a_ticketmaster:
