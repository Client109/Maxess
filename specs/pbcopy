      description: "Primary event source — live queries to Ticketmaster Discovery API (DMA 324)"
      type: "Live API integration"
      api_key_status: "Pending — will be obtained from developer.ticketmaster.com"
      rate_limits: "5,000 requests/day, 5 requests/second"
      base_url: "https://app.ticketmaster.com/discovery/v2"
      client_class: "src/lib/api/ticketmaster.ts (extends BaseApiClient)"
      cache_strategy: "Event search results cached 5 min, individual events cached 15 min"
      fields_per_event: 36
      stats:
        total_events: 20
        unique_venues: 8
        events_on_sale: 16
        events_with_presale: 15
        events_with_spotify_url: 16
        events_with_addon_products: 12
        genre_coverage: ["Pop", "Hip-Hop/Rap", "Rock", "Metal", "Latin", "Country", "Classical"]
      venues:
        - "Crypto.com Arena"
        - "BMO Stadium"
        - "Greek Theatre"
        - "Hollywood Pantages Theatre"
        - "Dodger Stadium"
        - "The Wiltern"
        - "Walt Disney Concert Hall"
        - "Orpheum Theatre"
