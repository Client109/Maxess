        - { name: "Don Toliver: Octane Tour", date: "Jun 28–29, 2026", genre: "Hip-Hop/Rap", venue: "Crypto.com Arena", status: "On sale", presale: true, featured: true }
        - { name: "Joshua Bell w/ Jeremy Denk", date: "Jun 3, 2026", genre: "Classical", venue: "Walt Disney Concert Hall", status: "On sale", presale: false }
        - { name: "Fuerza Regida: This Is Our Dream Stadium Tour", date: "Jul 18, 2026", genre: "Latin", venue: "Dodger Stadium", status: "On sale", presale: true }
        - { name: "Belicofest", date: "Jul 12, 2026", genre: "Latin", venue: "BMO Stadium", status: "On sale", presale: true }
        - { name: "TRAIN — Drops of Jupiter: 25 Years", date: "Aug 24, 2026", genre: "Rock", venue: "Greek Theatre", status: "On sale", presale: true }
        - { name: "Avenged Sevenfold, Good Charlotte", date: "Aug 30, 2026", genre: "Rock", venue: "BMO Stadium", status: "On sale", presale: true }
