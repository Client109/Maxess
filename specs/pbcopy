    source_b_spotify:
      description: "Primary music intelligence — artist data, search, track metadata, relevance scoring"
      type: "Live API integration"
      auth_flow: "Client Credentials (no user OAuth needed for demo — artist data, search, tracks)"
      note: "User-specific endpoints (top artists, recently played) require Authorization Code + PKCE flow, deferred until auth is implemented. User listening data simulated via seed data for demo."
      rate_limits: "1,000 requests/hour per user"
      base_url: "https://api.spotify.com/v1"
      client_class: "src/lib/api/spotify.ts (extends BaseApiClient)"
      capabilities:
        - "Artist search and metadata"
        - "Track metadata and preview URLs"
        - "Related artists for recommendation"
        - "Artist top tracks"
      fallback: "Last.fm (see source_c)"

    source_c_lastfm:
      description: "Secondary music intelligence — fallback when Spotify unavailable, scrobble history, artist tags, similar artists"
      type: "Live API integration"
      auth_flow: "API key only (no OAuth)"
      rate_limits: "5 requests/second"
      base_url: "https://ws.audioscrobbler.com/2.0"
      client_class: "src/lib/api/lastfm.ts (extends BaseApiClient)"
      capabilities:
        - "User top artists (if Last.fm username stored)"
        - "User top tracks and scrobble counts"
        - "Artist info and tags"
        - "Similar artists for recommendation"
      role: "Fallback when Spotify rate-limited or missing data. Also provides deeper scrobble history and artist tags not available from Spotify Client Credentials."

    source_d_postgresql:
      description: "All user/fan data — profiles, XP, leaderboard, challenges, passes, activity"
      type: "PostgreSQL via Prisma ORM with @prisma/adapter-pg (direct TCP connection)"
      schema: "prisma/schema.prisma"
      local_dev: "prisma dev server (postgres://localhost:51214), seed via prisma/seed.ts with pg adapter"
      query_functions: "src/lib/server/database.ts (12 functions ready)"
      models: ["User", "Event", "UserEvent", "Challenge", "UserChallenge", "XpTransaction", "Pass", "FriendActivity", "RecentActivity", "LeaderboardEntry"]

    source_e_listener_activity:
      owner: "Ethan"
      description: "Seed data for demo user profiles — loaded into PostgreSQL via prisma db seed"
      fields_per_record: 14
      records:
        - { name: "Alex Chen", city: "Los Angeles", artist: "Drake", tier: "Gold", xp_today: 420, engagement: 91, streak: 12, attended: true, role: "demo user" }
        - { name: "Maya Brooks", city: "Los Angeles", artist: "The Weeknd", tier: "Silver", xp_today: 260, engagement: 76, streak: 6, attended: false }
        - { name: "Jordan Lee", city: "Chicago", artist: "Drake", tier: "Platinum", xp_today: 610, engagement: 97, streak: 21, attended: true }
        - { name: "Sophia Carter", city: "New York", artist: "SZA", tier: "Gold", xp_today: 195, engagement: 68, streak: 4, attended: false }
        - { name: "Noah Patel", city: "Toronto", artist: "PARTYNEXTDOOR", tier: "Gold", xp_today: 510, engagement: 93, streak: 15, attended: true }
      notes:
        - "Alex Chen city MUST be Los Angeles (not Toronto) for leaderboard demo"
        - "Alex Chen xp_total MUST be 8,750 cumulative (not just today's 420)"

    source_f_gmail_attachment:
      owner: "Kayah"
      description: "Gmail attachment data file — contents TBD"
      action: "Download, identify fields, determine which JSON files it feeds, share field names with Luke"

    source_g_reference_datasets:
      spotify_million_playlist:
        description: "100M+ track interactions from 1M playlists (AIcrowd)"
        role: "Reference for streaming signal field structure — not loaded at runtime"
      seatdata_api:
        description: "Ticketing and venue data API with seat maps and pricing"
        role: "Future production upgrade path — Luke's Ticketmaster data covers MVP"
      datacamp_redshift:
        description: "Sample cloud database dataset"
        role: "Reference for Kayah's database hosting decision — not used tonight"

  screen_specifications:
    home:
      route: "/"
      primary_components:
        - "Brand header with Zap icon + MAXESS wordmark"
        - "Time-based greeting (Good morning/afternoon/evening, Alex)"
        - "Momentum Score hero card with sparkline SVG, tier badge, XP progress bar, and weekly delta"
        - "Upcoming For You section with event cards featuring Unsplash concert images"
        - "Your Ranking card with rank, percentile, city leaderboard position"
        - "Community Activity feed showing friend actions"
        - "Trending Near You section with genre-tagged event chips"
      required_interactions:
        - "XP progress bar animates to fill percentage on load"
        - "Event cards link to /events"
        - "Your Ranking card links to /rank-rewards"
        - "Community Activity shows friend names with action descriptions"
      after_data_layer: "Real fan score (8,750 XP), real Elite tier badge, real 12-day streak, server-side data from PostgreSQL, community activity from friends data"

    events:
      route: "/events"
      primary_components:
        - "Filter chips for category, date, and price selection"
        - "Search bar with real-time filtering"
        - "Event cards with image, venue, date, presale indicators"
        - "Bookmark toggles with state persistence"
        - "Featured hero cards for top 2 events"
        - "Genre filter across 7 real genres"
      required_interactions:
        - "Filter chips update displayed events in real time"
        - "Search query filters events as user types"
        - "Date picker for event filtering"
        - "Bookmark toggle persists during session"
        - "Notify Me button state management"
      after_data_layer: "20 real LA music events + 4 mock sports events. Real venues, real presale flags, real dates. Featured cards with Spotify links. Genre filter works across 7 real genres."
      featured_events:
        - { name: "Ariana Grande — The Eternal Sunshine Tour", reason: "Mainstream pop appeal, Crypto.com Arena, presale, Spotify URL" }
        - { name: "Don Toliver: Octane Tour", reason: "Hip-Hop/Rap, Spotify URL, presale via Citi card, strong fan engagement signal" }
      genre_to_category_mapping:
        music: ["Pop", "Hip-Hop/Rap", "Rock", "Metal", "Latin", "Country", "Classical"]
        sports: ["(4 mock sports events: Ducks vs Kings, Lakers, Honda Center night, Dodgers game)"]
      category_chips:
